{
  "manifest_version": 3,
  "name": "Astroflix",
  "version": "1.1.0",
  "description": "Manda o vídeo da aula aberta para uma playlist do Astroflix, que baixa e guarda o progresso.",
  "permissions": ["webRequest", "storage", "activeTab", "scripting", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Adicionar ao Astroflix" }
}
